{
  "name": "qml-viewer",
  "version": "1.0.0",
  "description": "QML Editor and Previewer",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:win": "vite --config vite.win.config.ts",
    "build": "vite build",
    "build:win": "vite build --config vite.win.config.ts && node -e \"require('fs').copyFileSync('electron/preload.cjs', 'dist-electron/preload.cjs')\"",
    "server": "vite preview",
    "win": "npm run build:win && electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.0.0",
    "monaco-editor": "^0.53.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
